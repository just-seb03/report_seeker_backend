# =============================================================================
# Plantilla de Configuración de Entorno (Report Seeker Backend)
# Copia este archivo como .env y completa los valores correspondientes
# =============================================================================

# Configuración de Seguridad Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_de_64_caracteres_en_produccion
DJANGO_ALLOWED_HOSTS=*

# =============================================================================
# Configuración de Base de Datos
# =============================================================================
# Opción A: SQLite (Recomendado para evaluación rápida y desarrollo sin MySQL)
DB_ENGINE=sqlite

# Opción B: MySQL / MariaDB 8.4 (Producción o servidor local MySQL)
# DB_ENGINE=mysql
# DB_NAME=report_seeker_db
# DB_USER=root
# DB_PASSWORD=123456
# DB_HOST=127.0.0.1
# DB_PORT=3306

# =============================================================================
# Configuración de Servidor de Correos SMTP (Report Seeker)
# =============================================================================
# Ejemplo 1: Con servicio transaccional (Brevo / Sendinblue)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_login_de_brevo@smtp-brevo.com
EMAIL_HOST_PASSWORD=tu_master_key_smtp
DEFAULT_FROM_EMAIL=Report Seeker <tu_login_de_brevo@smtp-brevo.com>

# Ejemplo 2: Con cuenta Gmail (Requiere activar 'Contraseña de Aplicación' en Google)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
# DEFAULT_FROM_EMAIL=Report Seeker <tu_correo@gmail.com>
